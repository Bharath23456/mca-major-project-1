APP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
CPU_THRESHOLD_PERCENT=85
MEMORY_THRESHOLD_PERCENT=90
DISK_THRESHOLD_PERCENT=90
# Forecast warning events are opt-in and require an operator/admin action.
CAPACITY_FORECAST_WARNINGS_ENABLED=false
# Escalate a correlated incident as repeat event links accumulate.
INCIDENT_REPEAT_WARNING_COUNT=3
INCIDENT_REPEAT_CRITICAL_COUNT=5
# Lookback window for same-target incident recurrence and priority scoring.
INCIDENT_REPEAT_WINDOW_HOURS=24
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
LOGIN_IDENTITY_LIMIT=5
LOGIN_IP_LIMIT=20
LOGIN_WINDOW_SECONDS=900
# Local loopback demo only; use recaptcha mode for any shared deployment.
CAPTCHA_MODE=test
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
